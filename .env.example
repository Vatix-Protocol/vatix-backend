# Indexer HTTP server (opt-in)
INDEXER_HTTP_ENABLED=false

# Comma-separated list of origins allowed to call the indexer HTTP server from a browser.
# When unset, the indexer CORS middleware falls back to a public wildcard (`*`).
# Example: INDEXER_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
INDEXER_CORS_ALLOWED_ORIGINS=
