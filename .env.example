# Indexer HTTP server (opt-in)
INDEXER_HTTP_ENABLED=false

# Comma-separated list of origins allowed to call the indexer HTTP server from a browser.
# When unset, the indexer CORS middleware falls back to a public wildcard (`*`).
# Example: INDEXER_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
INDEXER_CORS_ALLOWED_ORIGINS=

# Comma-separated list of Stellar addresses authorized to challenge a
# resolution candidate (POST /resolutions/:id/challenge) regardless of
# market oracle / bond status (see #1544). Optional; unset means no
# address is authorized purely by this allowlist — the market's own
# oracle address and bonded challengers (CollateralDeposit) are still checked.
CHALLENGE_ADMIN_ADDRESSES=
